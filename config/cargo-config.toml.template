# Portable Cargo configuration for the air-gapped corporate network.
#
# Replace the example index URL before using this file. The sparse registry URL
# must start with "sparse+https://" and end with "/". Do not put a registry token
# in this file; provide it through Cargo's registry token environment variable.

[registries.crates-io-mirror]
index = "sparse+https://cargo.example.corp/crates-io/index/"
credential-provider = "cargo:token"

[source.crates-io]
replace-with = "crates-io-mirror"

[registry]
global-credential-providers = ["cargo:token"]

[net]
retry = 10

[http]
timeout = 120
low-speed-limit = 1

# Some corporate proxies handle HTTP/2 poorly. Uncomment this only when
# registry logs or network diagnostics indicate an HTTP/2 problem.
# multiplexing = false
